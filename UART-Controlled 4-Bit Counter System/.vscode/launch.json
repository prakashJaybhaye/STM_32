{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Debug",
      "type": "cortex-debug",
      "request": "launch",

      "servertype": "openocd",

      "cwd": "${workspaceRoot}",
      "executable": "main.elf",

      "device": "STM32F446RE",

      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],

      "runToEntryPoint": "main",

      "svdFile": "",

      "preLaunchTask": "",

      "postLaunchCommands": [
        "monitor reset halt"
      ]
    }
  ]
}